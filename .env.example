# --- Server ---
PORT=3000

# --- LLM provider priority (comma-separated, left = tried first) ---
# Provider ids match @free-ai-gateway/core adapter ids: google_ai_studio, groq,
# cohere, openrouter, sambanova, nvidia_nim, huggingface, ollama, ...
# Any provider left out of this list is still tried, just after the ones listed.
LLM_PROVIDER_PRIORITY=google_ai_studio,groq,cohere

# --- Provider API keys (set only the ones you actually use; free tiers) ---
GOOGLE_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=

# --- LLM request behaviour ---
LLM_TIMEOUT_MS=12000

# --- Optional: switch to the zero-dependency direct-fetch LLM backend if
# @free-ai-gateway/core cannot be used in a given environment. ---
LLM_BACKEND=free-ai-gateway
