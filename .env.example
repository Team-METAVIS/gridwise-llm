# ==============================================================================
# GridWise LLM - Environment Configuration
# BUP CSE Fest 2026 Hackathon (Smart Campus Energy Optimization Challenge)
# ==============================================================================
# Copy this file to .env and configure at least ONE provider API key.
# DO NOT commit real API keys or secrets to git.

# --- Server Configuration ---
PORT=3000

# --- LLM Architecture & Backend Selection ---
# Backend options:
# - free-ai-gateway (default): multi-provider routing via @free-ai-gateway/core
#   with circuit breakers, priority ordering, and automatic failover to direct fetch.
# - direct: zero-dependency direct-fetch backend (OpenAI, Groq, Google Gemini)
#   with round-robin model rotation and in-call rate-limit fallback.
# - openai: direct-fetch targeting OpenAI or any OpenAI-compatible endpoint.
LLM_BACKEND=free-ai-gateway

# --- Provider Priority Order (for @free-ai-gateway/core) ---
# Comma-separated provider adapter IDs (leftmost = highest priority).
# Supported adapters: openai, google_ai_studio, groq, cohere, openrouter, sambanova, nvidia_nim, etc.
# Providers not listed are still attempted as fallback if their key is present.
LLM_PROVIDER_PRIORITY=openai,google_ai_studio,groq,cohere

# --- Provider API Keys & Model Rotation ---
# At least ONE key is required for live LLM interpretation.
# If a model ID is NOT explicitly pinned, the direct backend automatically rotates
# across verified free/available models per call with in-call fallback.

# 1. OpenAI & OpenAI-Compatible Endpoints (DeepSeek, OpenRouter, Together, Ollama/vLLM, etc.)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini                    # Optional: pins model (auto-rotates gpt-4o-mini, gpt-4o, gpt-3.5-turbo if unset)

# 2. Google Gemini (Google AI Studio)
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash               # Optional: pins model (auto-rotates gemini-2.5-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-flash-lite-latest if unset)

# 3. Groq Cloud
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b              # Optional: pins model (auto-rotates openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b, groq/compound, groq/compound-mini if unset)

# 4. Other Supported Free-Tier Providers
COHERE_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
NVIDIA_NIM_API_KEY=
HUGGINGFACE_API_KEY=

# --- Performance & Timeout Budget ---
# Timeout per LLM request in milliseconds (default: 12000ms = 12s).
# Must be well within the 30-second per-request budget mandated by Problem Statement §06.1.
LLM_TIMEOUT_MS=12000
