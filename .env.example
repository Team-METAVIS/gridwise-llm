# --- Server ---
PORT=3000

# --- LLM provider priority (comma-separated, left = tried first) ---
# Provider ids match @free-ai-gateway/core adapter ids or direct backend:
# openai, google_ai_studio, groq, cohere, openrouter, sambanova, nvidia_nim, huggingface, ollama, ...
# Any provider left out of this list is still tried, just after the ones listed.
LLM_PROVIDER_PRIORITY=openai,google_ai_studio,groq,cohere

# --- Provider API keys & model configuration ---
# OpenAI & OpenAI-compatible providers (DeepSeek, OpenRouter, local vLLM/Ollama, etc.)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini                    # Optional: pins model (rotates gpt-4o-mini, gpt-4o, gpt-3.5-turbo if unset)

GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash               # Optional: pins model (rotates gemini-2.0-flash, gemini-1.5-flash, etc. if unset)

GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile          # Optional: pins model (rotates llama-3.3-70b-versatile, llama-3.1-8b-instant, etc. if unset)

COHERE_API_KEY=
OPENROUTER_API_KEY=

# --- LLM request behaviour ---
LLM_TIMEOUT_MS=12000

# --- Optional: switch LLM backend ---
# Options:
# - free-ai-gateway (default): multi-provider routing with automatic fallback to direct fetch
# - direct: zero-dependency direct-fetch backend (OpenAI, Groq, Google)
# - openai: zero-dependency direct-fetch backend targeting OpenAI / OpenAI-compatible endpoint
LLM_BACKEND=free-ai-gateway

